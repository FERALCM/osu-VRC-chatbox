<Window x:Class="OsuVrcChatbox.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="osu! → VRChat chatbox" Height="720" Width="480"
        MinWidth="440" MinHeight="560" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="8,6,8,6" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Output banner -->
        <Border DockPanel.Dock="Top" Padding="10,8" >
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#9E9E9E" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding OutputActive}" Value="True">
                            <Setter Property="Background" Value="#2E7D32" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding OutputStateText}" Foreground="White"
                           FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                <Button Grid.Column="1" Content="Start/Stop" Command="{Binding ToggleOutputCommand}"
                        Margin="6,0" Padding="8,3" />
                <Button Grid.Column="2" Content="Clear" Command="{Binding ClearChatboxCommand}"
                        Padding="8,3" />
            </Grid>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Status -->
                <GroupBox Header="Status">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="tosu source" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SourceStatus}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="osu! state" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding OsuState}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="OSC target" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DestinationText}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Last packet sent" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastSentText}" Style="{StaticResource Value}" />
                    </Grid>
                </GroupBox>

                <!-- Live values -->
                <GroupBox Header="Live osu! values">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Song" Style="{StaticResource Label}" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentSong}" Style="{StaticResource Value}" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="PP / miss / combo" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding PpText}" Style="{StaticResource Value}" />
                            <TextBlock Text="pp   " Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding MissesText}" Style="{StaticResource Value}" />
                            <TextBlock Text="miss   " Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding ComboText}" Style="{StaticResource Value}" />
                        </StackPanel>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Elapsed / length" Style="{StaticResource Label}" />
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Value}" />
                            <TextBlock Text=" / " Style="{StaticResource Label}" />
                            <TextBlock Text="{Binding LengthText}" Style="{StaticResource Value}" />
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Chatbox preview -->
                <GroupBox Header="Chatbox preview">
                    <StackPanel>
                        <Border Background="#111" CornerRadius="4" Padding="8" MinHeight="46">
                            <TextBlock Text="{Binding PreviewText}" Foreground="#EEE"
                                       FontFamily="Consolas" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Margin="0,4,0,0" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#666" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNearLimit}" Value="True">
                                            <Setter Property="Foreground" Value="#C62828" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding CharCountText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Template -->
                <GroupBox Header="Message template">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Preset" Style="{StaticResource Label}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}"
                                      SelectedItem="{Binding SelectedPreset}" />
                        </Grid>
                        <CheckBox Content="Use custom template" IsChecked="{Binding UseCustomTemplate}" Margin="0,6,0,2" />
                        <TextBox Text="{Binding CustomTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding UseCustomTemplate}" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="40" />
                        <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,2,0,0"
                                   Text="Tokens: {artist} {title} {difficulty} {elapsed} {remaining} {length} {pp} {misses} {combo} {maxCombo} {mods} {accuracy} {starrating}" />
                        <CheckBox Content="Prefer Unicode metadata (non-ASCII may not render in VRChat)"
                                  IsChecked="{Binding PreferUnicode}" Margin="0,6,0,0" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Length source" Style="{StaticResource Label}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LengthSources}"
                                      SelectedItem="{Binding LengthSource}" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Output / rate -->
                <GroupBox Header="Output">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Update interval" Style="{StaticResource Label}" />
                            <Slider Grid.Column="1" Minimum="2" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding UpdateIntervalSeconds}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                <Run Text="{Binding UpdateIntervalSeconds, Mode=OneWay}" /><Run Text="s" />
                            </TextBlock>
                        </Grid>
                        <CheckBox Content="Play VRChat notification sound" IsChecked="{Binding NotificationSound}" Margin="0,6,0,0" />
                        <CheckBox Content="Clear chatbox when gameplay ends / output stops" IsChecked="{Binding ClearOnStop}" Margin="0,4,0,0" />
                        <CheckBox Content="Keep final result visible after a play" IsChecked="{Binding KeepFinalResultVisible}" Margin="0,4,0,0" />
                    </StackPanel>
                </GroupBox>

                <!-- Connection -->
                <GroupBox Header="Connection">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="70" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="tosu host / port" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding TosuHost}" Margin="0,2" />
                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding TosuPort}" Margin="4,2,0,2" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="VRChat OSC ip / port" Style="{StaticResource Label}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OscIp}" Margin="0,2" />
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding OscPort}" Margin="4,2,0,2" />
                        <Button Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Content="Apply &amp; reconnect"
                                Command="{Binding ApplyConnectionCommand}" HorizontalAlignment="Right"
                                Padding="10,3" Margin="0,4,0,0" />
                    </Grid>
                </GroupBox>

                <!-- Application -->
                <GroupBox Header="Application" Margin="8,6,8,12">
                    <StackPanel>
                        <CheckBox Content="Start minimized" IsChecked="{Binding StartMinimized}" Margin="0,2" />
                        <CheckBox Content="Minimize to tray" IsChecked="{Binding MinimizeToTray}" Margin="0,2" />
                        <CheckBox Content="Start with Windows" IsChecked="{Binding StartWithWindows}" Margin="0,2" />
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Global pause hotkey" Style="{StaticResource Label}" />
                            <TextBox Grid.Column="1" Text="{Binding GlobalPauseHotkey}" />
                            <Button Grid.Column="2" Content="Open logs" Command="{Binding OpenLogsCommand}"
                                    Padding="8,3" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
